# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec: one file for Windows and Linux, onedir layout.

Nothing heavy is bundled: yt-dlp, ffmpeg and deno are downloaded at first run
(core/installer.py). If a smoke test shows 'ModuleNotFoundError: X', remove X
from EXCLUDES below."""
import os
import sys
from pathlib import Path

import customtkinter

ROOT = Path(SPECPATH)                         # noqa: F821  (injected by PyInstaller)
sys.path.insert(0, str(ROOT))
from core.version import APP_SLUG             # noqa: E402

IS_WIN = sys.platform.startswith("win")
# strip debug symbols on Linux (needs binutils; set PYI_NO_STRIP=1 to skip)
STRIP = (not IS_WIN) and not os.environ.get("PYI_NO_STRIP")
ICO = ROOT / "assets" / "icon.ico"            # generated by packaging/make_ico.py (Windows only)

datas = [
    # customtkinter: only its themes + fonts as data; its code is found via normal imports
    (str(Path(customtkinter.__file__).parent / "assets"), "customtkinter/assets"),
    (str(ROOT / "assets" / "icon.png"), "assets"),   # Tk window icon (PNG works on both OSes)
    (str(ROOT / "assets" / "icons"), "assets/icons"),  # UI line icons (plain PNGs, no Pillow needed)
    (str(ROOT / "assets" / "fonts"), "assets/fonts"),  # bundled Inter (SIL OFL) + its licence
]
if ICO.exists():
    datas.append((str(ICO), "assets"))

EXCLUDES = [
    # stdlib we never use
    "unittest", "pydoc", "doctest", "pdb", "test", "tkinter.test", "xmlrpc",
    "lib2to3", "distutils", "sqlite3", "curses",
    # packaging tools
    "setuptools", "pkg_resources", "pip", "wheel",
    # Pillow is build-time only (icon conversion); the app uses Tk's native PNG support
    "PIL", "numpy", "matplotlib", "IPython", "pytest",
    # never bundled: downloaded at first run / replaced by tinytag
    "yt_dlp", "mutagen", "static_ffmpeg",
]

a = Analysis(
    [str(ROOT / "main.py")],
    pathex=[str(ROOT)],
    datas=datas,
    hiddenimports=["lzma", "tinytag"],        # lzma: unpacking the .tar.xz ffmpeg on Linux
    excludes=EXCLUDES,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz, a.scripts, [],
    exclude_binaries=True,                    # onedir: libs live next to the exe
    name=APP_SLUG,
    console=False,
    icon=str(ICO) if (IS_WIN and ICO.exists()) else None,
    strip=STRIP,
    upx=False,                                # UPX raises antivirus false positives
)
coll = COLLECT(exe, a.binaries, a.datas, strip=STRIP, upx=False, name=APP_SLUG)
